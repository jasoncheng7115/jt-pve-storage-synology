#!/usr/bin/perl

# pve-syno-api-probe — read-only discovery of a Synology DSM's SAN Web API.
#
# Synology publishes no complete specification for the SAN Manager Web API.
# Everything this project knows about it was read from two implementations —
# Synology's own CSI driver and OpenStack Cinder's Synology driver — and the
# two disagree about which methods exist, which parameters they take, and how
# parameters are encoded. Neither implements a snapshot rollback at all.
#
# So the facts have to come off a real NAS, and this tool is how. It asks a
# DSM what it supports and prints it, and it never writes anything: no LUN is
# created, resized, renamed, mapped, cloned, snapshotted or deleted, and no
# target is touched. It is safe against a production NAS, which is what it was
# written for.
#
# The one thing that needs saying out loud: --probe-methods sends candidate
# method names naming a LUN and snapshot uuid the NAS has never issued, so a
# method that exists can only refuse — and the refusal code proves it is there.
# DSM answers 103 for a method it does not have, and an object-not-found code
# for one it does. Nothing it could act on is real, but the names being sent are
# destructive ones, so it is behind its own flag and off by default.
#
# It has already earned its keep: on a DSM 7.1.1 it found restore_snapshot,
# which neither reference implementation has, out of nine candidate names.

use strict;
use warnings;

use Getopt::Long qw(:config no_ignore_case bundling);
use JSON;
use LWP::UserAgent;
use HTTP::Request::Common qw(POST);
use POSIX ();

# Term::ReadKey is not installed on a stock Proxmox VE node and this tool has
# to run there, so echo is turned off with stty. The restore is registered as
# an END block BEFORE echo is disabled, not written after the read: a die or a
# Ctrl-C between the two would otherwise leave the operator's terminal silent
# with no clue why.
my $echo_off = 0;

# NO SUBPROCESS. This used to shell out to `stty`, which is a command run by
# bare name — the thing that cost this project a whole incident when a PVE
# daemon turned out to have no PATH at all. This tool only ever runs from a
# shell, so its own PATH would have been fine; the point is that the rule has no
# exceptions worth arguing about when the alternative is in core Perl.
#
# POSIX::Termios is that alternative: it turns echo off through the same
# termios(3) call stty would have made, with nothing to find and nothing to
# exec. If the terminal cannot be configured, the password is echoed rather than
# the tool refusing to run.
my $termios;
my $saved_lflag;

sub _echo_off {
    return 0 if !-t STDIN;
    $termios = POSIX::Termios->new;
    return 0 if !defined eval { $termios->getattr(fileno(STDIN)); 1 };
    $saved_lflag = $termios->getlflag;
    return 0 if !defined $saved_lflag;
    $termios->setlflag($saved_lflag & ~POSIX::ECHO());
    $termios->setattr(fileno(STDIN), POSIX::TCSANOW());
    return 1;
}

sub _echo_on {
    return if !defined $termios || !defined $saved_lflag;
    $termios->setlflag($saved_lflag);
    $termios->setattr(fileno(STDIN), POSIX::TCSANOW());
}

END { _echo_on() if $echo_off }

sub read_password {
    my ($prompt) = @_;
    print STDERR $prompt;
    $echo_off = _echo_off();
    ## no critic (InputOutput::ProhibitExplicitStdin)
    # <> would read @ARGV as filenames — for a PASSWORD prompt that is not a
    # style question: it would silently take the password from a file named on
    # the command line, or from a pipe, with echo suppression already applied.
    my $answer = <STDIN>;
    if ($echo_off) {
        _echo_on();
        $echo_off = 0;
        print STDERR "\n";
    }
    $answer //= '';
    chomp $answer;
    return $answer;
}

my $VERSION = '0.6.26';

my $host;
my $port;
my $user;
my $pass = $ENV{SYNO_PASSWORD};
my $otp;
my $device_id;
my $https        = 1;
my $verify       = 0;
my $timeout      = 15;
my $probe_methods = 0;
my $show_luns     = 1;
my $json_out      = 0;
my $help          = 0;
my $show_version  = 0;

GetOptions(
    'host|H=s'      => \$host,
    'port|p=i'      => \$port,
    'user|u=s'      => \$user,
    'password=s'    => \$pass,
    'otp=s'         => \$otp,
    'device-id=s'   => \$device_id,
    'https!'        => \$https,
    'verify!'       => \$verify,
    'timeout=i'     => \$timeout,
    'probe-methods' => \$probe_methods,
    'luns!'         => \$show_luns,
    'json'          => \$json_out,
    'help|h'        => \$help,
    'version'       => \$show_version,
) or usage(1);

usage(0) if $help;
if ($show_version) { print "pve-syno-api-probe $VERSION\n"; exit 0 }
usage(1) if !$host || !$user;

$port //= $https ? 5001 : 5000;

# A password on the command line is visible in ps output and lands in the
# shell history. Prompting is the default; --password and SYNO_PASSWORD are
# there for scripts that already have it.
if (!defined $pass) {
    $pass = read_password("DSM password for $user\@$host: ");
}

die "a password is required\n" if $pass eq '';

if (!$https) {
    warn <<'EOM';
WARNING: --no-https sends the DSM password over plain HTTP. DSM's own clients
         encrypt it with a server-supplied RSA key in that case; this tool does
         not, because this project will not support plain HTTP. Use it only on
         a network you would send the password over anyway.
EOM
}

# ---------------------------------------------------------------------------
# Transport
# ---------------------------------------------------------------------------

my $scheme = $https ? 'https' : 'http';
my $base   = "$scheme://$host:$port";

my %ssl_opts = $https && !$verify
    ? (ssl_opts => { verify_hostname => 0, SSL_verify_mode => 0 })
    : ();

my $ua = LWP::UserAgent->new(
    timeout => $timeout,
    agent   => "pve-syno-api-probe/$VERSION",
    %ssl_opts,
);
# A redirect to a login page is an answer, not a place to resend credentials.
$ua->max_redirect(0);

my $sid;
my $syno_token;
my %api_info;    # api name => { path, minVersion, maxVersion, requestFormat }

# Every call is a POST with a form body. DSM accepts GET with the parameters in
# the query string — Synology's CSI driver logs in that way — but that writes
# the password into the NAS's own access log and into any proxy between here
# and it.
sub call {
    my ($api, $method, $version, $params, %opt) = @_;

    my $path = $opt{cgi} // ($api_info{$api} ? $api_info{$api}{path} : 'entry.cgi');

    my %form = (
        api     => $api,
        method  => $method,
        version => $version,
        %{ $params // {} },
    );
    $form{_sid} = $sid if defined $sid && !$opt{no_sid};

    # DSM's Control Panel has "Improve protection against cross-site request
    # forgery attacks". With it on, a session alone is not enough: every
    # request has to echo back the token the login issued, or the NAS answers
    # 105 (insufficient permission) — which reads exactly like an account that
    # lacks a privilege, and sends everyone looking in the wrong place.
    # Neither reference client handles this, so neither works on a NAS with
    # that setting enabled.
    $form{SynoToken} = $syno_token if defined $syno_token && !$opt{no_sid};

    # An API whose requestFormat is JSON wants every parameter JSON-encoded —
    # a string quoted, a number bare. This is why Synology's CSI driver wraps
    # names in strconv.Quote and its numbers not at all; it is not decoration.
    # The NAS says which APIs those are, so ask it rather than deciding here.
    # Written as a guarded lookup rather than $api_info{$api}{requestFormat},
    # which would autovivify an empty entry for every API asked about and make
    # a later "does this NAS advertise it" test answer yes.
    my $fmt = $api_info{$api} ? ($api_info{$api}{requestFormat} // '') : '';

    my $json_params = exists $opt{json_params}
        ? $opt{json_params}
        : ($fmt eq 'JSON' ? 1 : 0);

    if ($json_params) {
        for my $k (keys %form) {
            next if $k =~ /^(?:api|method|version|_sid)\z/;
            next if ref $form{$k};
            $form{$k} = encode_json_scalar($form{$k});
        }
    }

    my $req = POST "$base/webapi/$path", [ %form ];

    # This NAS answers 119 (SID not found) to a request whose session is only
    # in the `_sid` form parameter, which is the way OpenStack Cinder's driver
    # carries it. The cookie is what it accepts — the way Synology's own CSI
    # driver does it. So send both: the cookie because it works here, `_sid`
    # because a DSM that wants that instead is not going to say so either.
    if (defined $sid && !$opt{no_sid}) {
        $req->header(Cookie => "id=$sid");
        # DSM's own web interface sends the anti-CSRF token as a header. The
        # form parameter above covers the other convention.
        $req->header('X-SYNO-TOKEN' => $syno_token) if defined $syno_token;
    }

    my $res = $ua->request($req);

    my $out = {
        http    => $res->code,
        success => 0,
        error   => undef,
        data    => undef,
    };

    if (!$res->is_success && $res->code != 302) {
        $out->{transport} = $res->status_line;
        return $out;
    }

    # decoded_content returns characters; decode_json wants bytes, and DSM
    # answers text/* often enough that the charset guess turns every byte
    # above 0x7F into a wide character. Ask for the bytes.
    my $body = $res->decoded_content(charset => 'none');
    my $json = eval { decode_json($body) };
    if (!$json) {
        $out->{transport} = 'response is not JSON: ' . snippet($body);
        return $out;
    }

    $out->{success} = $json->{success} ? 1 : 0;
    $out->{error}   = $json->{error}{code} if ref $json->{error};
    $out->{data}    = $json->{data};

    return $out;
}

sub encode_json_scalar {
    my ($v) = @_;
    return $v if $v =~ /\A-?(?:0|[1-9][0-9]*)\z/;    # a plain integer
    return $v if $v =~ /\A[\[\{]/;                   # already JSON
    my $s = encode_json([$v]);
    $s =~ s/\A\[//; $s =~ s/\]\z//;
    return $s;
}

sub snippet {
    my ($s) = @_;
    $s //= '';
    $s =~ s/\s+/ /g;
    return length($s) > 120 ? substr($s, 0, 120) . '...' : $s;
}

# DSM's common error codes. Anything above 18990000 is SAN Manager's own.
my %COMMON_ERR = (
    100 => 'unknown error',
    101 => 'invalid parameter',
    102 => 'API does not exist',
    103 => 'method does not exist',
    104 => 'version not supported',
    105 => 'insufficient permission',
    106 => 'session timeout',
    107 => 'session interrupted by a duplicate login',
    119 => 'SID not found',
    400 => 'invalid credentials',
    402 => 'account disabled, or 2-factor authentication required',
    403 => 'one-time password required',
    404 => 'one-time password rejected',
);

my %ISCSI_ERR = (
    18990002 => 'out of free space',
    # Observed on a write test: a 255-character LUN name is refused with this
    # code AND the LUN is created anyway. A failed create must therefore be
    # followed by a lookup, never believed.
    18990068 => 'name too long — and the object may exist regardless (observed)',
    # Observed: an illegal character in a name. `_`, space, `+` and `@` are
    # refused; `-`, `.`, `:` and upper case are accepted.
    18990503 => 'illegal name (observed)',
    # Observed from SYNO.Core.ISCSI.Host `get` given a uuid that does not
    # exist. Not in either reference client's table; recorded because the code
    # is the only thing worth keying a decision on.
    18990004 => 'no such object (observed, undocumented)',
    18990500 => 'bad LUN type',
    18990505 => 'bad LUN UUID',
    18990531 => 'no such LUN',
    18990532 => 'no such snapshot',
    18990538 => 'duplicate LUN name',
    18990541 => 'LUN count limit reached',
    18990542 => 'target count limit reached',
    18990543 => 'snapshot count limit reached',
    18990744 => 'duplicate target name',
);

sub err_text {
    my ($code) = @_;
    return 'no error' if !defined $code;
    my $t = $COMMON_ERR{$code} // $ISCSI_ERR{$code} // 'undocumented';
    return "$code ($t)";
}

# ---------------------------------------------------------------------------
# Report
# ---------------------------------------------------------------------------

my %report;

sub say_head {
    my ($t) = @_;
    return if $json_out;
    print "\n$t\n", '-' x length($t), "\n";
    return;
}

sub say_line {
    my ($fmt, @args) = @_;
    return if $json_out;
    printf "$fmt\n", @args;
    return;
}

# ---------------------------------------------------------------------------
# 1. API discovery
# ---------------------------------------------------------------------------

say_head('API discovery (SYNO.API.Info, query=all)');

{
    my $r = call('SYNO.API.Info', 'query', 1, { query => 'all' },
        cgi => 'query.cgi', no_sid => 1);

    if (!$r->{success}) {
        my $why = $r->{transport} // err_text($r->{error});
        die "SYNO.API.Info refused: $why\n"
          . "Nothing else can be trusted without it — every version this tool\n"
          . "would send would be a guess. Check the host, the port and --https.\n";
    }

    %api_info = %{ $r->{data} };
    $report{api_count} = scalar keys %api_info;
    say_line('  %d APIs advertised', $report{api_count});

    my @interesting = sort grep {
        /^SYNO\.Core\.ISCSI\.|^SYNO\.San\.|^SYNO\.Core\.Storage\.
        |^SYNO\.API\.(?:Auth|Encryption)\z|^SYNO\.Core\.System\z
        |^SYNO\.Core\.Network\.Interface\z/x
    } keys %api_info;

    for my $api (@interesting) {
        my $i = $api_info{$api};
        say_line('  %-44s v%s-%s  %-14s %s',
            $api,
            $i->{minVersion} // '?',
            $i->{maxVersion} // '?',
            $i->{path}       // '?',
            $i->{requestFormat} ? "requestFormat=$i->{requestFormat}" : '');
        $report{apis}{$api} = $i;
    }

    # The APIs this project needs, and whether they are there at all.
    for my $need (qw(
        SYNO.API.Auth
        SYNO.Core.ISCSI.LUN
        SYNO.Core.ISCSI.Target
        SYNO.Core.ISCSI.Node
        SYNO.Core.Storage.Volume
        SYNO.Core.System
    )) {
        say_line('  %-44s %s', $need, $api_info{$need} ? 'present' : '*** ABSENT ***');
        $report{required}{$need} = $api_info{$need} ? 1 : 0;
    }
}

my $lun_json_params =
    ($api_info{'SYNO.Core.ISCSI.LUN'}{requestFormat} // '') eq 'JSON' ? 1 : 0;

# ---------------------------------------------------------------------------
# 2. Login
# ---------------------------------------------------------------------------

say_head('Authentication (SYNO.API.Auth)');

{
    my $auth_max = $api_info{'SYNO.API.Auth'}{maxVersion} // 6;
    my $auth_ver = $auth_max >= 6 ? 6 : $auth_max;

    my %p = (
        account            => $user,
        passwd             => $pass,
        session            => 'dsm',
        format             => 'sid',
        enable_syno_token  => 'yes',
    );
    if (defined $device_id) {
        $p{device_id} = $device_id;
    } elsif (defined $otp) {
        $p{otp_code}            = $otp;
        $p{enable_device_token} = 'yes';
    }

    # Both reference clients post the login to auth.cgi. DSM 7 advertises
    # SYNO.API.Auth on entry.cgi, so use the path the NAS gave and keep
    # auth.cgi only as the fallback for a DSM that did not say.
    my $auth_cgi = $api_info{'SYNO.API.Auth'}{path} // 'auth.cgi';

    my $r = call('SYNO.API.Auth', 'login', $auth_ver, \%p,
        cgi => $auth_cgi, no_sid => 1);

    if (!$r->{success}) {
        my $why = $r->{transport} // err_text($r->{error});
        die "login failed: $why\n"
          . (defined $r->{error} && $r->{error} == 403
              ? "This account has 2-factor authentication on. Re-run with --otp <code>;\n"
              . "the tool will report the device token DSM issues, and that token can be\n"
              . "used with --device-id afterwards instead of a code.\n"
              : '');
    }

    $sid = $r->{data}{sid};
    say_line('  login OK (SYNO.API.Auth v%d on %s, session=dsm, format=sid)',
        $auth_ver, $auth_cgi);
    $report{auth_version} = $auth_ver;
    $report{auth_path}    = $auth_cgi;

    if ($r->{data}{synotoken}) {
        $syno_token = $r->{data}{synotoken};
        say_line('  CSRF token issued — this DSM has the anti-CSRF setting ON.');
        say_line('  Every later request must echo it back or the NAS answers 105,');
        say_line('  which looks like a permission problem and is not one. Neither');
        say_line('  reference client sends it, so neither works on this NAS.');
        $report{syno_token_required} = 1;
    } else {
        $report{syno_token_required} = 0;
    }

    if ($r->{data}{did}) {
        say_line('  device token issued: %s', $r->{data}{did});
        say_line('  Keep it: with --device-id it logs in without a one-time code.');
        say_line('  Treat it as a credential — it is a standing 2FA bypass for');
        say_line('  this account, so it does not belong in a repository.');
        $report{device_token} = $r->{data}{did};
    }
}

# Log out on the way out whatever happens, so the probe leaves no session
# behind on a production NAS.
END {
    if ($sid) {
        local $@;
        eval {
            call('SYNO.API.Auth', 'logout', 1, { session => 'dsm' },
                cgi => $report{auth_path} // 'auth.cgi');
        };
    }
}

# ---------------------------------------------------------------------------
# 3. Identity and capability gates
# ---------------------------------------------------------------------------

say_head('System');

for my $type (qw(firmware define network)) {
    my $r = call('SYNO.Core.System', 'info', 1, { type => $type });
    if (!$r->{success}) {
        say_line('  info type=%-9s refused: %s', $type, $r->{transport} // err_text($r->{error}));
        next;
    }
    my $d = $r->{data};
    if ($type eq 'firmware') {
        say_line('  model            %s', $d->{model}        // '?');
        say_line('  firmware_ver     %s', $d->{firmware_ver} // '?');
        $report{system}{model}        = $d->{model};
        $report{system}{firmware_ver} = $d->{firmware_ver};
    } elsif ($type eq 'network') {
        say_line('  hostname         %s', $d->{hostname} // '?');
        $report{system}{hostname} = $d->{hostname};
    } else {
        # The gates Cinder's driver checks before it will use a NAS at all.
        for my $k (qw(support_iscsi_target supportsnapshot support_vaai
                      support_storage_mgr support_nvmeof usbstation)) {
            next if !exists $d->{$k};
            say_line('  %-16s %s', $k, $d->{$k});
            $report{system}{$k} = $d->{$k};
        }
    }
}

{
    my $r = call('SYNO.Core.ISCSI.Node', 'list', 1, {});
    if ($r->{success} && ref $r->{data}{nodes} eq 'ARRAY' && @{ $r->{data}{nodes} }) {
        my $uuid = $r->{data}{nodes}[0]{uuid};
        say_line('  node uuid        %s', $uuid // '?');
        say_line('                   (the NAS\'s own identity — this is what a storage');
        say_line('                    should be pinned to, not the address it answers on)');
        $report{node_uuid} = $uuid;
    } else {
        say_line('  SYNO.Core.ISCSI.Node list refused: %s',
            $r->{transport} // err_text($r->{error}));
    }
}

# ---------------------------------------------------------------------------
# 4. DSM volumes — where a LUN can live
# ---------------------------------------------------------------------------

say_head('DSM volumes (SYNO.Core.Storage.Volume)');
say_line('  A thin LUN only supports snapshot and restore on a Btrfs volume.');
say_line('  fs_type is therefore a hard requirement, not a preference.');
say_line('');

{
    my $r = call('SYNO.Core.Storage.Volume', 'list', 1,
        { offset => 0, limit => -1, location => 'all' });

    if (!$r->{success}) {
        say_line('  refused: %s', $r->{transport} // err_text($r->{error}));
    } else {
        my $vols = $r->{data}{volumes} // [];
        say_line('  %-12s %-8s %-10s %10s %10s %s',
            'volume_path', 'fs_type', 'status', 'total GiB', 'free GiB', 'readonly');
        for my $v (@$vols) {
            say_line('  %-12s %-8s %-10s %10.1f %10.1f %s',
                $v->{volume_path}    // '?',
                $v->{fs_type}        // '?',
                $v->{status}         // '?',
                ($v->{size_total_byte} // 0) / 1024 ** 3,
                ($v->{size_free_byte}  // 0) / 1024 ** 3,
                (defined $v->{readonly} ? ($v->{readonly} ? 'yes' : 'no') : '?'));
            push @{ $report{volumes} }, $v;
        }
        my @btrfs = grep { ($_->{fs_type} // '') eq 'btrfs' } @$vols;
        say_line('');
        say_line('  usable for this plugin (Btrfs): %s',
            @btrfs ? join(' ', map { $_->{volume_path} } @btrfs) : 'NONE');
    }
}

# ---------------------------------------------------------------------------
# 5. LUNs and targets as they are now
# ---------------------------------------------------------------------------

if ($show_luns) {
    say_head('LUNs (SYNO.Core.ISCSI.LUN list)');

    # Listed WITHOUT a types filter, deliberately. Synology's CSI driver sends
    # an explicit twelve-type list, and on the test NAS that list hid a LUN —
    # so the filter is not merely unverified, it is known to be incomplete. A
    # listing that quietly omits objects is read as "this is everything" by
    # whatever decides what may be deleted or how much space is provisioned.
    my $r = call('SYNO.Core.ISCSI.LUN', 'list',
        $api_info{'SYNO.Core.ISCSI.LUN'}{maxVersion} // 1,
        { additional => '["allocated_size","status","flashcache_status","is_action_locked"]' },
        json_params => 0,
    );

    if (!$r->{success}) {
        say_line('  refused: %s', $r->{transport} // err_text($r->{error}));
        say_line('  Retrying with every parameter JSON-encoded, which is what');
        say_line('  requestFormat=JSON asks for...');
        $r = call('SYNO.Core.ISCSI.LUN', 'list',
            $api_info{'SYNO.Core.ISCSI.LUN'}{maxVersion} // 1,
            { additional => '["allocated_size","status","is_action_locked"]' },
            json_params => 1);
        say_line('  %s', $r->{success} ? 'that worked — parameters must be JSON-encoded'
                                       : 'also refused: ' . ($r->{transport} // err_text($r->{error})));
    }

    if ($r->{success}) {
        my $luns = $r->{data}{luns} // [];
        say_line('  %d LUNs', scalar @$luns);
        say_line('  %-30s %-5s %-10s %10s %-8s %s',
            'name', 'type', 'location', 'GiB', 'status', 'uuid');
        for my $l (@$luns) {
            say_line('  %-30s %-5s %-10s %10.1f %-8s %s',
                $l->{name}     // '?',
                $l->{type}     // '?',
                $l->{location} // '?',
                ($l->{size} // 0) / 1024 ** 3,
                $l->{status}   // '?',
                $l->{uuid}     // '?');
            # vpd_unit_sn is the SCSI VPD unit serial number, which is what the
            # node's WWID is built out of — the one field that lets a LUN be
            # matched to a device by the kernel's own identification of it
            # rather than by the path it was found on. Neither reference client
            # reads it. lun_id and restored_time are equally unremarked on, and
            # restored_time existing is evidence that a restore API does.
            say_line('       vpd_unit_sn=%s lun_id=%s type_str=%s',
                $l->{vpd_unit_sn} // '-', $l->{lun_id} // '-', $l->{type_str} // '-');
            say_line('       block_size=%s allocated=%.1f GiB create_from=%s restored_time=%s',
                $l->{block_size} // '-',
                ($l->{allocated_size} // 0) / 1024 ** 3,
                (defined $l->{create_from} && $l->{create_from} ne '' ? $l->{create_from} : '-'),
                $l->{restored_time} // '-');
        }
        $report{lun_count} = scalar @$luns;
        # Kept whole, not just counted: the filtered-versus-unfiltered
        # comparison later needs the uuids to say which LUNs a filter hides.
        $report{luns} = $luns;
        $report{lun_sample_keys} = [ sort keys %{ $luns->[0] // {} } ];
        say_line('');
        say_line('  fields a LUN row actually carries: %s',
            join(', ', @{ $report{lun_sample_keys} })) if @$luns;

        # `list` does not carry dev_attribs; `get` does. Reading one existing
        # LUN is the only way to learn which attribute names this DSM uses and
        # what it defaults them to — and those are what decide whether a thin
        # LUN ever gives space back. Synology's CSI driver takes them entirely
        # from its caller and defaults nothing.
        if (@$luns) {
            my $one = $luns->[0];
            my $g = call('SYNO.Core.ISCSI.LUN', 'get', 1,
                { uuid => $one->{uuid},
                  additional => '["allocated_size","status","is_action_locked"]' });
            if ($g->{success} && ref $g->{data}{lun}) {
                my $attrs = $g->{data}{lun}{dev_attribs};
                say_line('');
                say_line('  dev_attribs of an existing LUN (%s):', $one->{name} // '?');
                if (ref $attrs eq 'ARRAY' && @$attrs) {
                    for my $a (@$attrs) {
                        say_line('    %-28s enable=%s',
                            $a->{dev_attrib} // '?', $a->{enable} // '?');
                    }
                } else {
                    say_line('    none reported — %s',
                        JSON->new->canonical->encode($attrs // 'absent'));
                }
                $report{dev_attribs} = $attrs;
                say_line('  full field list from get: %s',
                    join(', ', sort keys %{ $g->{data}{lun} }));
            } else {
                say_line('  get on one LUN refused: %s',
                    $g->{transport} // err_text($g->{error}));
            }
        }
    }

    say_head('Targets (SYNO.Core.ISCSI.Target list)');

    my $t = call('SYNO.Core.ISCSI.Target', 'list',
        $api_info{'SYNO.Core.ISCSI.Target'}{maxVersion} // 1,
        { additional => '["mapped_lun","connected_sessions"]' });

    if (!$t->{success}) {
        say_line('  refused: %s', $t->{transport} // err_text($t->{error}));
    } else {
        my $trgs = $t->{data}{targets} // [];
        say_line('  %d targets', scalar @$trgs);
        for my $x (@$trgs) {
            say_line('  id=%-4s max_sessions=%-4s %s',
                $x->{target_id} // '?', $x->{max_sessions} // '?', $x->{iqn} // '?');
            say_line('       name=%s status=%s mapped_luns=%d sessions=%d',
                $x->{name} // '?', $x->{status} // '?',
                scalar @{ $x->{mapped_luns} // [] },
                scalar @{ $x->{connected_sessions} // [] });
            for my $m (@{ $x->{mapped_luns} // [] }) {
                say_line('       lun %s at mapping_index %s',
                    $m->{lun_uuid} // '?', $m->{mapping_index} // '?');
            }
        }
        $report{target_count} = scalar @$trgs;
        $report{target_sample_keys} = [ sort keys %{ $trgs->[0] // {} } ];
        say_line('');
        say_line('  max_sessions must be 0 (unlimited) for a target a whole PVE');
        say_line('  cluster logs in to. A target left at 1 admits one node.');
    }

    # Neither Synology's CSI driver nor OpenStack Cinder's driver knows this
    # object exists, and it is the one that decides whether a target is open to
    # every initiator on the network or only to the nodes of one cluster. For a
    # storage several PVE nodes share, that is the difference between access
    # control and none.
    say_head('Initiators / access control (SYNO.Core.ISCSI.Host)');

    if (!$api_info{'SYNO.Core.ISCSI.Host'}) {
        say_line('  this DSM does not advertise the API');
    } else {
        my $h = call('SYNO.Core.ISCSI.Host', 'list', 1, {});
        if (!$h->{success}) {
            say_line('  list refused: %s', $h->{transport} // err_text($h->{error}));
            say_line('  The method may not be called "list". What this object is');
            say_line('  named and what it takes is the first thing to settle for');
            say_line('  a shared storage.');
        } else {
            $report{iscsi_host} = $h->{data};
            say_line('  %s', JSON->new->canonical->encode($h->{data}));
            say_line('');
            say_line('  Read the keys above against SAN Manager\'s own screen: the');
            say_line('  product calls this access control by IQN, with initiators');
            say_line('  grouped.');
        }
    }

    say_head('Storage pools (SYNO.Core.Storage.Pool)');

    if (!$api_info{'SYNO.Core.Storage.Pool'}) {
        say_line('  this DSM does not advertise the API');
    } else {
        my $p = call('SYNO.Core.Storage.Pool', 'list', 1, {});
        if (!$p->{success}) {
            say_line('  list refused: %s', $p->{transport} // err_text($p->{error}));
        } else {
            my $pools = $p->{data}{pools} // $p->{data};
            $report{pools} = $pools;
            if (ref $pools eq 'ARRAY') {
                for my $x (@$pools) {
                    say_line('  id=%s status=%s raid=%s size=%s',
                        $x->{id} // '?', $x->{status} // '?',
                        (ref $x->{pool_path} ? '?' : ($x->{raid_type} // '?')),
                        $x->{size_total} // '?');
                }
            } else {
                say_line('  %s', snippet(JSON->new->canonical->encode($pools)));
            }
        }
    }
}

# ---------------------------------------------------------------------------
# 6. Method existence — the open questions
# ---------------------------------------------------------------------------

say_head('Method existence');

my @CANDIDATES = (
    # The one operation with no reference implementation anywhere: rolling a
    # LUN back onto one of its own snapshots. SAN Manager's UI calls it
    # Restore, so the method is there under some name; these are the names it
    # could plausibly have.
    [ 'SYNO.Core.ISCSI.LUN' => 'restore_snapshot'  ],
    [ 'SYNO.Core.ISCSI.LUN' => 'rollback_snapshot' ],
    [ 'SYNO.Core.ISCSI.LUN' => 'revert_snapshot'   ],
    [ 'SYNO.Core.ISCSI.LUN' => 'snapshot_restore'  ],
    [ 'SYNO.Core.ISCSI.LUN' => 'snapshot_rollback' ],
    [ 'SYNO.Core.ISCSI.LUN' => 'restore'           ],
    [ 'SYNO.Core.ISCSI.LUN' => 'rollback'          ],
    [ 'SYNO.Core.ISCSI.LUN' => 'revert'            ],
    [ 'SYNO.Core.ISCSI.LUN' => 'restore_from_snapshot' ],
);

# Every candidate is asked about a LUN and a snapshot that cannot exist. A
# uuid DSM has never issued is a stronger safety property than sending no
# parameters at all: a method with an all-optional signature could act on a
# default when given nothing, whereas one told to operate on this uuid can only
# refuse. And the refusal is more informative — 18990505 / 18990531 / 18990532
# name the object it could not find, which proves both that the method exists
# and that it got as far as looking.
my $NOWHERE = '00000000-0000-0000-0000-0000pveprobe';

my @HOST_CANDIDATES = map { [ 'SYNO.Core.ISCSI.Host' => $_ ] }
    qw(list enum get query info);

if (!$probe_methods) {
    say_line('  skipped. --probe-methods asks the NAS which of these exist:');
    say_line('    %s', join(', ', map { $_->[1] } @CANDIDATES));
    say_line('');
    say_line('  Each is sent naming a LUN and a snapshot uuid the NAS has never');
    say_line('  issued (%s),', $NOWHERE);
    say_line('  so an existing method can only refuse. The error code answers the');
    say_line('  question:');
    say_line('    103         no such method');
    say_line('    18990505/31 method exists, no such LUN');
    say_line('    18990532    method exists, no such snapshot');
    say_line('    101         method exists, wants different parameters');
    say_line('');
    say_line('  These are still destructive methods being named, so the flag is');
    say_line('  opt-in even though nothing they could act on is real.');
} else {
    say_line('  Naming a LUN and snapshot uuid the NAS has never issued, so an');
    say_line('  existing method can only refuse:  %s', $NOWHERE);
    say_line('');

    my $probe = sub {
        my ($api, $method, $params, %o) = @_;
        return if !$api_info{$api};

        my $r = call($api, $method, $api_info{$api}{maxVersion} // 1, $params);
        my $code = $r->{error};

        # For a listing, succeeding IS the expected answer and means the method
        # is there. Only a *destructive* candidate succeeding is alarming, and
        # conflating the two cried wolf on the first real run.
        my $verdict =
            $r->{success} && $o{read_only} ? 'PRESENT — returned data, as a read method should'
          : $r->{success}      ? 'SUCCEEDED — stop and investigate before doing anything else'
          : !defined $code     ? 'no error code: ' . ($r->{transport} // '?')
          : $code == 103       ? 'absent'
          : $code == 102       ? 'API absent'
          : $code == 104       ? 'version not supported'
          : $code == 105       ? 'no permission for this account (or CSRF token missing)'
          : $code == 101       ? 'PRESENT — wants other parameters (101)'
          : 'PRESENT — refused on the fake object: ' . err_text($code);

        say_line('  %-26s %s', $method, $verdict);
        $report{methods}{"$api.$method"} = { code => $code, verdict => $verdict };
    };

    say_line('  snapshot rollback candidates (SYNO.Core.ISCSI.LUN):');
    $probe->($_->[0], $_->[1], {
        snapshot_uuid => $NOWHERE,
        src_lun_uuid  => $NOWHERE,
        uuid          => $NOWHERE,
    }) for @CANDIDATES;

    say_line('');
    say_line('  read methods of the access-control object (SYNO.Core.ISCSI.Host):');
    $probe->($_->[0], $_->[1], {}, read_only => 1) for @HOST_CANDIDATES;
}

# ---------------------------------------------------------------------------
# 6b. Does `list` page, and does it say so?
# ---------------------------------------------------------------------------

say_head('Listing completeness');
say_line('  A listing that silently caps reads as "this is everything", and the');
say_line('  callers that decide what may be DELETED are the ones that read it.');
say_line('  So: does LUN list honour a limit, and does it report a total?');
say_line('');

if ($api_info{'SYNO.Core.ISCSI.LUN'} && defined $report{lun_count}) {
    my $r = call('SYNO.Core.ISCSI.LUN', 'list', 1,
        { offset => 0, limit => 1,
          additional => '["allocated_size","status","is_action_locked"]' });

    if (!$r->{success}) {
        say_line('  limit=1 refused: %s — offset/limit may not be accepted here',
            $r->{transport} // err_text($r->{error}));
    } else {
        my $n = scalar @{ $r->{data}{luns} // [] };
        my @keys = sort grep { !/^luns\z/ } keys %{ $r->{data} };
        say_line('  asked for 1 of %d, got %d', $report{lun_count}, $n);
        say_line('  other keys beside luns: %s', @keys ? join(', ', @keys) : 'NONE');
        if ($n == 1) {
            say_line('  => limit IS honoured, so a bare list may be capped by a');
            say_line('     server-side default. Find the total before trusting one.');
        } else {
            say_line('  => limit is IGNORED: the listing returns everything it has.');
            say_line('     Nothing reports a total either, so a short answer cannot');
            say_line('     be told from a complete one — only a second read can.');
        }
        $report{list_limit_honoured} = ($n == 1 ? 1 : 0);
        $report{list_extra_keys}     = \@keys;
    }

    # The filter Synology's own CSI driver sends, compared against the
    # unfiltered listing above. Any LUN that appears only in the unfiltered
    # answer is one that a client trusting that filter cannot see — and its
    # capacity still comes out of the same volume.
    say_line('');
    say_line('  Now the same listing WITH the CSI driver\'s twelve-type filter,');
    say_line('  to see whether that filter hides anything:');

    my $f = call('SYNO.Core.ISCSI.LUN', 'list', 1,
        { types => '["BLOCK","FILE","THIN","ADV","SINK","CINDER","CINDER_BLUN","CINDER_BLUN_THICK","BLUN","BLUN_THICK","BLUN_SINK","BLUN_THICK_SINK"]',
          additional => '["allocated_size","status","is_action_locked"]' },
        json_params => 0);

    if (!$f->{success}) {
        say_line('  refused: %s', $f->{transport} // err_text($f->{error}));
    } else {
        my %seen = map { ($_->{uuid} // '') => 1 } @{ $f->{data}{luns} // [] };
        my @hidden = grep { !$seen{ $_->{uuid} // '' } } @{ $report{luns} // [] };
        say_line('  filtered: %d of %d', scalar @{ $f->{data}{luns} // [] },
            $report{lun_count});
        if (@hidden) {
            say_line('  *** the filter HIDES %d LUN(s):', scalar @hidden);
            for my $h (@hidden) {
                say_line('        %s  type=%s (%s)  %.1f GiB',
                    $h->{name} // '?', $h->{type} // '?',
                    $h->{type_str} // '?', ($h->{size} // 0) / 1024 ** 3);
            }
            say_line('      So do not send that filter. List unfiltered and match');
            say_line('      locally on the name, which is the only ownership test');
            say_line('      this plugin trusts anyway.');
        } else {
            say_line('  => the filter hides nothing on this NAS. It still should not');
            say_line('     be relied on: it hid a VDISK_BLUN on another one.');
        }
        $report{types_filter_hides} = [ map { $_->{name} } @hidden ];
    }
} else {
    say_line('  skipped: the LUN listing above did not succeed');
}

# ---------------------------------------------------------------------------
# 7. What this run settled, and what it did not
# ---------------------------------------------------------------------------

say_head('Register');

my @btrfs = grep { ($_->{fs_type} // '') eq 'btrfs' } @{ $report{volumes} // [] };

say_line('  settled by this run:');
say_line('    - the API set and every version range this NAS accepts');

# "Not asked" is not "cannot". The first run of --probe-methods used --no-luns,
# and this line reported that the account could NOT read LUNs — which was
# false, and is exactly the confusion between "could not ask" and "the answer
# is no" that the plugin's own rules forbid. Skipped, refused and succeeded are
# three different outcomes.
say_line('    - %s',
      !$show_luns                  ? 'LUN and target listings were SKIPPED (--no-luns), so this'
                                     . ' run says nothing about them'
    : defined $report{lun_count}   ? 'the account can read LUNs and targets'
    :                                'the account could NOT read LUNs or targets — see the'
                                     . ' refusals above');
say_line('    - %d Btrfs volume(s), so thin LUNs with snapshots are%s possible',
    scalar @btrfs, @btrfs ? '' : ' NOT');
say_line('    - %s',
    $report{node_uuid} ? 'the NAS reports a node uuid to pin a storage to'
                       : 'no node uuid could be read');
if (my $m = $report{methods}) {
    my @present = grep { ($m->{$_}{verdict} // '') =~ /^PRESENT/ } sort keys %$m;
    if (@present) {
        say_line('    - these methods exist on this DSM:');
        say_line('        %s', $_) for @present;
    }
}

say_line('');
say_line('  NOT settled — these need a write, on a volume nobody minds:');
say_line('    - LUN name length limit and legal characters');
say_line('    - size granularity: create an odd size, read back what was made');
say_line('    - whether unmap_target replaces a LUN\'s target list or adds to it');
say_line('    - whether a LUN with snapshots refuses to be deleted');
say_line('    - whether clone_snapshot is thin or a full copy');
say_line('    - how long is_action_locked stays set, and on which operations');
say_line('    - for any restore method found above: its PARAMETER names, and');
say_line('      whether a rollback keeps newer snapshots and preserves the');
say_line('      LUN uuid. Knowing a method exists is not knowing what it does');

if ($json_out) {
    print JSON->new->canonical->pretty->encode(\%report);
}

exit 0;

sub usage {
    my ($code) = @_;
    print STDERR <<"EOM";
pve-syno-api-probe $VERSION — read-only discovery of a Synology DSM SAN API

  pve-syno-api-probe --host <ip> --user <account> [options]

  -H, --host <ip>        DSM address (required)
  -p, --port <n>         default 5001 with https, 5000 without
  -u, --user <account>   DSM account (required)
      --password <pw>    default: prompt. SYNO_PASSWORD is also read.
      --otp <code>       one-time code, for an account with 2FA
      --device-id <tok>  device token from an earlier --otp login
      --no-https         plain HTTP (sends the password in the clear)
      --verify           verify the TLS certificate (DSM ships a self-signed
                         one, so this is off by default)
      --timeout <s>      per-request timeout, default 15
      --probe-methods    ask which snapshot-restore method names exist
      --no-luns          skip the LUN and target listings
      --json             also print the findings as JSON
  -h, --help             this

Nothing this tool does changes the NAS, with the single exception described
under --probe-methods, which is off unless asked for.
EOM
    exit $code;
}
